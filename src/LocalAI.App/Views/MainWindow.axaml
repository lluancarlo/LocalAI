<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LocalAI.App.ViewModels"
        xmlns:views="using:LocalAI.App.Views"
        xmlns:audio="using:LocalAI.Core.Audio"
        xmlns:speech="using:LocalAI.Core.Speech"
        x:Class="LocalAI.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Local AI"
        Width="1180" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <views:StatusBrushConverter x:Key="StatusBrush" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.author">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource AiBrush}" />
    </Style>
    <Style Selector="TextBlock.author.user">
      <Setter Property="Foreground" Value="{StaticResource UserBrush}" />
    </Style>
    <Style Selector="TextBlock.author.system">
      <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    </Style>
    <Style Selector="ListBox#ConversationList ListBoxItem">
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.record">
      <Setter Property="Background" Value="{StaticResource RecordBrush}" />
      <Setter Property="Foreground" Value="#0E1015" />
    </Style>
    <!-- Live button: large, accent-coloured while active -->
    <Style Selector="ToggleButton.live">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource AiBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AiBrush}" />
    </Style>
    <Style Selector="ToggleButton.live:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AiBrush}" />
      <Setter Property="Foreground" Value="#0E1015" />
    </Style>
    <Style Selector="ToggleButton.live:checked:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#B4DD8A" />
      <Setter Property="Foreground" Value="#0E1015" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,6" />
      <Setter Property="Foreground" Value="{StaticResource UserBrush}" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="250,*">

    <!-- ============ Sidebar ============ -->
    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
          <TextBlock Text="Local AI" FontSize="16" FontWeight="SemiBold" Margin="2,2,0,4" />
          <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding NewConversationCommand}" Content="＋  New conversation" ToolTip.Tip="Ctrl+N" />
          <TextBox Text="{Binding SearchText}" PlaceholderText="Search history…" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
          <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding ToggleMemoriesCommand}" Content="◆  Memory" />
          <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding ToggleSettingsCommand}" Content="⚙  Settings" />
          <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding ToggleDiagnosticsCommand}" Content="ⓘ  Diagnostics" />
        </StackPanel>

        <ListBox x:Name="ConversationList" Margin="0,10,0,0" Background="Transparent"
                 ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ConversationItemViewModel">
              <Panel>
                <Panel.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Rename" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BeginRenameCommand}" CommandParameter="{Binding}" InputGesture="F2" />
                    <MenuItem Header="Delete" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteConversationCommand}" CommandParameter="{Binding}" />
                  </ContextMenu>
                </Panel.ContextMenu>
                <StackPanel IsVisible="{Binding !IsRenaming}">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="muted" Text="{Binding When}" />
                  <TextBlock Classes="muted" Text="{Binding Snippet}" TextWrapping="Wrap" MaxLines="2"
                             IsVisible="{Binding Snippet, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <TextBox IsVisible="{Binding IsRenaming}" Text="{Binding EditTitle}" views:FocusOnVisible.Enabled="True"
                         KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" />
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ============ Main ============ -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto,Auto">

      <!-- Header -->
      <Border Grid.Row="0" Padding="18,12" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Classes="muted" VerticalAlignment="Center"
                     Text="Enter send · Shift+Enter newline · Esc stop · hold Ctrl+Space to talk" />
          <TextBlock Text="{Binding ConversationTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>

      <!-- Conversation -->
      <ScrollViewer Grid.Row="1" x:Name="MessagesScroll" Padding="0,8">
        <ItemsControl ItemsSource="{Binding Messages}" Margin="22,4,22,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MessageViewModel">
              <StackPanel Margin="0,10" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="author" Classes.user="{Binding IsUser}" Classes.system="{Binding IsSystem}" Text="{Binding Author}" />
                  <TextBlock Classes="muted" Text="{Binding Meta}" VerticalAlignment="Bottom" />
                  <TextBlock Classes="muted" Text="(stopped)" IsVisible="{Binding Interrupted}" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Bottom" />
                  <TextBlock Classes="muted" Text="…" IsVisible="{Binding IsStreaming}" VerticalAlignment="Bottom" />
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="&gt;" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                       FontFamily="{StaticResource MonoFont}" FontSize="14" LineHeight="21"
                                       Foreground="{StaticResource TextBrush}" />
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Banner (non-fatal errors) -->
      <Border Grid.Row="2" Background="#2A1E24" Padding="18,6" IsVisible="{Binding BannerText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding BannerText}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
      </Border>

      <!-- Input -->
      <Border Grid.Row="3" Padding="18,10" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="InputBox" Grid.Column="0" Text="{Binding InputText}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="44" MaxHeight="200" PlaceholderText="Type a message…" FontFamily="{StaticResource MonoFont}" />
            <Button Grid.Column="1" Margin="10,0,0,0" MinWidth="84" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center" Command="{Binding SendCommand}" Content="{Binding SendButtonText}" />
          </Grid>
          <WrapPanel Orientation="Horizontal">
            <ToggleButton Classes="live" Margin="0,0,10,6" IsChecked="{Binding IsContinuous}" IsEnabled="{Binding VoiceAvailable}"
                          Content="◉  Live" ToolTip.Tip="Live mode: just talk. The assistant answers aloud, listens again, and you can interrupt it at any time." />
            <Button x:Name="PushToTalkButton" Classes="flat" Classes.record="{Binding IsRecording}" Margin="0,0,10,6"
                    IsEnabled="{Binding VoiceAvailable}" Content="●  Hold to talk" ToolTip.Tip="Hold the button (or Ctrl+Space) while speaking" />
            <!-- Microphone level meter (visible while the microphone is open) -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,6" VerticalAlignment="Center" IsVisible="{Binding IsMicOpen}"
                        ToolTip.Tip="Microphone level (dBFS). Speech should peak around -30 to -10 dB.">
              <TextBlock Classes="muted" Text="mic" VerticalAlignment="Center" />
              <ProgressBar Width="140" Height="8" MinHeight="8" Minimum="0" Maximum="1" Value="{Binding MicLevel}"
                           Foreground="{Binding MicLevelBrush}" Background="{StaticResource PanelBorderBrush}" VerticalAlignment="Center" />
              <TextBlock Classes="muted" Text="{Binding MicLevelText}" MinWidth="52" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
            </StackPanel>
            <CheckBox Margin="0,0,16,6" IsChecked="{Binding SpeakReplies}" Content="Speak typed replies" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Status bar -->
      <Border Grid.Row="4" Background="{StaticResource PanelBrush}" Padding="18,5" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="9" Height="9" Fill="{Binding StatusLevel, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding StatusText}" MaxWidth="520" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Classes="muted" Text="{Binding GpuText}" />
          <TextBlock Classes="muted" Text="{Binding ModelText}" />
          <TextBlock Classes="muted" Text="{Binding VoiceText}" MaxWidth="420" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>

      <!-- Diagnostics overlay -->
      <Border Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding ShowDiagnostics}" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6"
              Margin="24" Padding="18" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="720">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Classes="flat" Content="✕" Command="{Binding ToggleDiagnosticsCommand}" />
            <TextBlock Text="Diagnostics" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <ScrollViewer>
            <SelectableTextBlock Text="{Binding DiagnosticsText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{StaticResource TextBrush}" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Settings overlay -->
      <Border Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding ShowSettings}" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6"
              Margin="24" Padding="18" HorizontalAlignment="Right" VerticalAlignment="Top" Width="560">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Classes="flat" Content="✕" Command="{Binding ToggleSettingsCommand}" />
            <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
          </DockPanel>
          <ScrollViewer MaxHeight="620">
            <StackPanel DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">

              <TextBlock Classes="section" Text="Audio devices" />
              <Grid ColumnDefinitions="90,*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Text="Microphone" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Microphones}"
                          SelectedItem="{Binding SelectedMicrophone}" PlaceholderText="No microphone found">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="audio:AudioDevice"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="0" Grid.Column="2" Classes="flat" Margin="8,0,0,0" Command="{Binding RefreshDevicesCommand}"
                        Content="↻" ToolTip.Tip="Rescan audio devices" />
                <TextBlock Grid.Row="1" Text="Speaker" VerticalAlignment="Center" Margin="0,8,0,0" />
                <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,8,0,0" ItemsSource="{Binding Speakers}"
                          SelectedItem="{Binding SelectedSpeaker}" PlaceholderText="No speaker found">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="audio:AudioDevice"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                <ToggleButton Classes="flat" IsChecked="{Binding IsTestingMicrophone}" Content="Test microphone"
                              ToolTip.Tip="Opens the microphone to show its level. Nothing is sent to the assistant." />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsMicOpen}">
                  <ProgressBar Width="180" Height="8" MinHeight="8" Minimum="0" Maximum="1" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MicLevel}"
                               Foreground="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MicLevelBrush}" Background="{StaticResource PanelBorderBrush}" VerticalAlignment="Center" />
                  <TextBlock Classes="muted" FontFamily="{StaticResource MonoFont}" MinWidth="52" VerticalAlignment="Center"
                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MicLevelText}" />
                </StackPanel>
              </StackPanel>

              <CheckBox Margin="0,10,0,0" IsChecked="{Binding EchoCancellation}"
                        Content="Echo cancellation (needed to interrupt the assistant on speakers)" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Margin="28,0,0,0"
                         Text="Uses Windows communications mode. Windows may lower other sounds while the microphone is open." />

              <TextBlock Classes="section" Text="Voices" />
              <ItemsControl ItemsSource="{Binding Languages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:VoiceLanguageViewModel">
                    <Grid ColumnDefinitions="140,*,Auto" Margin="0,0,0,8">
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Voices}" SelectedItem="{Binding Selected}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="speech:VoiceInfo"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="2" Classes="flat" Margin="8,0,0,0" Content="▶" Command="{Binding PreviewCommand}"
                              ToolTip.Tip="Play a sample with this voice" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="140,*,Auto" Margin="0,4,0,0">
                <TextBlock Text="Speaking rate" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Minimum="0.75" Maximum="1.5" SmallChange="0.05" LargeChange="0.1"
                        TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Speed}" />
                <TextBlock Grid.Column="2" Classes="muted" Margin="8,0,0,0" MinWidth="40" VerticalAlignment="Center" Text="{Binding SpeedText}" />
              </Grid>
              <TextBlock Classes="muted" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" Text="{Binding VoiceError}"
                         IsVisible="{Binding VoiceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0"
                         Text="More voices: scripts\setup.ps1 -AllVoices. The voice follows the language you speak." />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Memory overlay -->
      <Border Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding ShowMemories}" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6"
              Margin="24" Padding="18" HorizontalAlignment="Right" VerticalAlignment="Top" Width="520" MaxHeight="600">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Classes="flat" Content="✕" Command="{Binding ToggleMemoriesCommand}" />
            <TextBlock Text="Long-term memory" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Facts the assistant learned about you. Stored only in the local database; delete anything you don't want kept." />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Memories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MemoryItemViewModel">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <StackPanel>
                      <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" Text="{Binding Created}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="flat" Content="Delete" VerticalAlignment="Top" Margin="8,0,0,0"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteMemoryCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
